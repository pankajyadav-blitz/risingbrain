# ──────────────────────────────────────────────────────────────────────────────
# RisingBrain — PRODUCTION runtime config for the EC2 / docker-compose deploy.
#
#   cp .env.production.example .env.production   # then fill in the real values
#   docker compose -f docker-compose.prod.yml up -d --build
#
# `.env.production` is gitignored — it must NEVER be committed. Everything here
# is a placeholder.
#
# On VERCEL you do not use this file: set the same keys in
# Project → Settings → Environment Variables instead (see DEPLOY.md).
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Public base URL. Drives OAuth callbacks, canonical/OG URLs, the sitemap, and
# the Secure flag on auth cookies. MUST be https:// and MUST match the domain
# nginx serves and the callback URLs registered with Google/GitHub.
APP_URL=https://risingbrain.1000xdevs.dev

# Managed Postgres (Neon). Use the POOLED endpoint for the app.
# Migrations must instead be run against the DIRECT (non-pooled) endpoint.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Redis. Host is the compose service name `redis`, NOT localhost.
# Password must match REDIS_PASSWORD below.
REDIS_URL=redis://default:REPLACE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

# Auth. Generate with: openssl rand -base64 48
AUTH_SECRET=REPLACE_ME_RUN_OPENSSL_RAND_BASE64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=90

# Trusted reverse-proxy hop count for reading the client IP out of
# X-Forwarded-For. 0 is correct with a single nginx in front (whether it appends
# or replaces the header). Use 1 ONLY if you add Cloudflare/an ALB in front of
# nginx. Too high is the dangerous direction — see src/lib/env.ts.
TRUSTED_PROXY_HOPS=0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gmail SMTP for OTP / password-reset mail. Use an App Password, not the account
# password. MAIL_FROM must be a full mailbox, not a bare display name.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=Rising Brain <you@example.com>
