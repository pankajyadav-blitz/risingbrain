POSTGRES_USER=risingbrain
POSTGRES_PASSWORD=risingbrain
POSTGRES_DB=risingbrain
POSTGRES_PORT=5432

DATABASE_URL="postgresql://risingbrain:risingbrain@localhost:5432/risingbrain?schema=public"
REDIS_PASSWORD=risingbrain
REDIS_PORT=6379
REDIS_URL="redis://default:risingbrain@localhost:6379"
AUTH_SECRET="change-me-with-openssl-rand-base64-48"
# Access-token lifetime. Short by design — this is the revocation latency of the
# whole system (a ban or role change lands within one TTL). Expiry is invisible:
# the edge proxy and SessionKeepAlive rotate it silently. Accepts 30s/15m/2h/900.
ACCESS_TOKEN_TTL="15m"
# How long a user stays logged in while completely IDLE. It's a sliding window —
# every visit pushes it out by the full period — so an active user is never
# logged out by it. Raise this, not ACCESS_TOKEN_TTL, to lengthen sessions.
REFRESH_TOKEN_TTL_DAYS=90
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Public base URL. In PRODUCTION set this to your real HTTPS domain
# (e.g. https://risingbrain.co) — it drives OAuth callbacks, canonical/OG URLs,
# the sitemap, AND the Secure flag on auth cookies. Keep it https:// in prod.
APP_URL="http://localhost:3000"

# In PRODUCTION also set NODE_ENV=production in the deploy environment (NOT here —
# setting it in this file would break local dev). Secure cookies turn on when
# NODE_ENV=production OR APP_URL is https://, so an https APP_URL alone is enough.
# NODE_ENV=production

GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM=""
