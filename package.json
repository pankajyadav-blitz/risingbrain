{
  "name": "risingbrain",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "bun --filter @risingbrain/database db:migrate",
    "db:studio": "bun --filter @risingbrain/database db:studio",
    "db:seed": "bun --filter @risingbrain/database db:seed",
    "db:update-dsa": "bun --filter @risingbrain/database db:update-dsa",
    "db:seed-domain": "bun --filter @risingbrain/database db:seed-domain",
    "db:seed-domain-sql": "bun --filter @risingbrain/database db:seed-domain-sql",
    "db:seed-domain-dbms": "bun --filter @risingbrain/database db:seed-domain-dbms",
    "db:seed-interviews": "bun --filter @risingbrain/database db:seed-interviews",
    "db:backfill-activity": "bun --filter @risingbrain/database db:backfill-activity",
    "db:setup": "turbo run db:generate && turbo run db:push && bun run db:seed",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.8.5",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
