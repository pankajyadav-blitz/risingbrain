{
  "name": "@risingbrain/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./generated/prisma/client.ts",
    "./enums": "./generated/prisma/enums.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun run prisma/seed.ts",
    "db:update-dsa": "bun run scripts/update-dsa.ts",
    "db:update-puzzles": "bun run scripts/update-puzzles.ts",
    "db:seed-domain": "bun run scripts/seed-domain.ts",
    "db:seed-domain-sql": "bun run scripts/seed-domain-sql.ts",
    "db:seed-domain-dbms": "bun run scripts/seed-domain-dbms.ts",
    "db:seed-domain-cn": "bun run scripts/seed-domain-cn.ts",
    "db:seed-domain-os": "bun run scripts/seed-domain-os.ts",
    "db:seed-interviews": "bun run scripts/seed-interviews.ts",
    "db:backfill-activity": "bun run scripts/backfill-activity.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:migrate-legacy": "bun run scripts/migrate-legacy.ts",
    "db:repair-domain": "bun run scripts/repair-domain-notes.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@risingbrain/config-eslint": "*",
    "@risingbrain/config-typescript": "*",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.1",
    "prisma": "^7.8.0",
    "typescript": "5.9.2"
  }
}
