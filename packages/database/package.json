  },
  "devDependencies": {
    "@risingbrain/config-eslint": "*",
    "@risingbrain/config-typescript": "*",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.1",
    "prisma": "^7.8.0",
    "typescript": "5.9.2"
  }
